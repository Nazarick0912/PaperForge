{
  "name": "@paperforge/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PaperForge Node.js + Hono backend application",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "build": "pnpm run typecheck && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:integrated": "node dist/index.js --integrated",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "2.1.11",
    "@paperforge/shared": "workspace:*",
    "content-type": "3.1.1",
    "hono": "4.13.22",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "vitest": "5.1.1"
  }
}
