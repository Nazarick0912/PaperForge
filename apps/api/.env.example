# PaperForge backend configuration
#
# Ordinary environment precedence (used by pnpm dev:api and pnpm start:api):
# 1. Explicit process environment variables
# 2. Optional apps/api/.env file (loaded via Node.js process.loadEnvFile)
# 3. Validated defaults
#
# NODE_ENV may be selected in apps/api/.env when no explicit process override exists.
#
# Compiled integrated startup (pnpm start):
# Runs the compiled server in an explicit local production mode (NODE_ENV=production)
# with compiled frontend serving from apps/web/dist, while still resolving HOST and
# PORT using ordinary environment precedence. Run "pnpm build" before "pnpm start".

HOST=127.0.0.1
PORT=3000
NODE_ENV=development

# Reserved for future infrastructure.
# DATA_DIR=<repository-root>/.data
# AI_PROVIDER=mock
# LOG_LEVEL=info
