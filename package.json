{
  "name": "paperforge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PaperForge AI-assisted educational authoring platform monorepo",
  "packageManager": "pnpm@11.29.0",
  "engines": {
    "node": ">=24.22.3 <25",
    "pnpm": "11.29.0"
  },
  "scripts": {
    "dev": "pnpm run build:shared && concurrently --kill-others --names shared,api,web --prefix-colors cyan,green,magenta \"pnpm --filter @paperforge/shared dev\" \"pnpm --filter @paperforge/api dev\" \"pnpm --filter @paperforge/web dev\"",
    "typecheck": "pnpm run build:shared && pnpm --filter @paperforge/api typecheck && pnpm --filter @paperforge/web typecheck",
    "build": "pnpm run build:shared && pnpm --filter @paperforge/api build && pnpm --filter @paperforge/web build",
    "test": "pnpm run build:shared && pnpm --filter @paperforge/shared test && pnpm --filter @paperforge/api test && pnpm --filter @paperforge/web test",
    "start": "pnpm --filter @paperforge/api start:integrated",
    "dev:shared": "pnpm --filter @paperforge/shared dev",
    "typecheck:shared": "pnpm --filter @paperforge/shared typecheck",
    "build:shared": "pnpm --filter @paperforge/shared build",
    "test:shared": "pnpm --filter @paperforge/shared test",
    "test:shared:watch": "pnpm --filter @paperforge/shared test:watch",
    "dev:web": "pnpm run build:shared && pnpm --filter @paperforge/web dev",
    "typecheck:web": "pnpm run build:shared && pnpm --filter @paperforge/web typecheck",
    "build:web": "pnpm run build:shared && pnpm --filter @paperforge/web build",
    "preview:web": "pnpm --filter @paperforge/web preview",
    "test:web": "pnpm run build:shared && pnpm --filter @paperforge/web test",
    "test:web:watch": "pnpm run build:shared && pnpm --filter @paperforge/web test:watch",
    "dev:api": "pnpm run build:shared && pnpm --filter @paperforge/api dev",
    "typecheck:api": "pnpm run build:shared && pnpm --filter @paperforge/api typecheck",
    "build:api": "pnpm run build:shared && pnpm --filter @paperforge/api build",
    "start:api": "pnpm --filter @paperforge/api start",
    "test:api": "pnpm run build:shared && pnpm --filter @paperforge/api test",
    "test:api:watch": "pnpm run build:shared && pnpm --filter @paperforge/api test:watch",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "10.0.7",
    "prettier": "3.10.1",
    "typescript": "6.0.3"
  }
}
