{
  "name": "paperforge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PaperForge AI-assisted educational authoring platform monorepo",
  "packageManager": "pnpm@11.29.0",
  "engines": {
    "node": ">=24.22.3 <25",
    "pnpm": "11.29.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @paperforge/web dev",
    "typecheck:web": "pnpm --filter @paperforge/web typecheck",
    "build:web": "pnpm --filter @paperforge/web build",
    "preview:web": "pnpm --filter @paperforge/web preview",
    "test:web": "pnpm --filter @paperforge/web test",
    "test:web:watch": "pnpm --filter @paperforge/web test:watch",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "typescript": "6.0.3"
  }
}
